diff --git a/.github/workflows/01-pr-check.yml b/.github/workflows/01-pr-check.yml
index 79bcdaf2..57e2cee8 100644
--- a/.github/workflows/01-pr-check.yml
+++ b/.github/workflows/01-pr-check.yml
@@ -659,3 +659,154 @@ jobs:
         if: steps.changes.outputs.frontend == 'true'
         working-directory: ./algo22-terminal
         run: npx vitest --run
+
+  # ───────────────────────────────────────────────────────────────────────────────
+  # PHASE 11B-A11 — TEMPORARY, NON-BLOCKING D5' REAL-REDIS DIAGNOSTIC JOB.
+  #
+  # WHY IT EXISTS. Run 38043513862 on this branch executed the nine gated real-Redis
+  # tests against the healthy `redis:7-alpine` service -- the D5' opt-in works -- but four
+  # of them FAILED and their tracebacks are UNRECOVERABLE: the `unit-tests` step log is
+  # truncated after the first failure's traceback, and this workflow uploads no artifacts,
+  # so `actions/runs/<id>/artifacts` returns total_count 0. The per-test outcomes were
+  # readable only from the `FAILED [NN%]` progress lines.
+  #
+  # The measured split that needs explaining:
+  #   test_quota01_metered_reservation_is_hard.py   7 passed / 0 failed
+  #   test_webhook_duplicate_delivery_real_redis.py 4 passed / 2 failed
+  #   test_quota01_exchange_slot_is_atomic.py       1 passed / 21 FAILED
+  # The slot-lock file's 21-of-22 failure is the anomaly. Its logic tests inject their own
+  # in-process `_LockStore` through the `slot_env` fixture and never build a TestClient, so
+  # the rate-limiter/ordering leak that explains this run's UNRELATED failures cannot
+  # explain them. Whole-file failure with one survivor is a fixture- or collection-level
+  # signature, not 21 independent logic defects -- but that is a hypothesis, and the
+  # tracebacks are what decide it.
+  #
+  # WHAT IT CHANGES ABOUT THE EVIDENCE, AND NOTHING ELSE.
+  #   * ONE INVOCATION PER FILE, so a failure in one file cannot truncate or hide another's
+  #     traceback -- which is exactly what happened in the full-suite run.
+  #   * `--tb=long -rf` for complete tracebacks and a terminal recap of failures only.
+  #   * `--junitxml` per file, uploaded with `if: always()`, so the result survives the run
+  #     as a durable artifact instead of a step log that gets truncated.
+  #   * EACH FILE RUNS ALONE. That is itself the experiment: if the 21 slot-lock failures
+  #     disappear here, the cause is full-suite state leakage; if they persist against the
+  #     same real Redis, the cause is in the file's own wiring or in the guard, and is a
+  #     genuine finding to fix at its source.
+  #
+  # `continue-on-error: true` AT THE JOB LEVEL IS NOT A PASS. This job is diagnostic. It
+  # must not gate the pull request, and it must not be read as satisfying the D5'
+  # acceptance criteria -- those still require the nine tests to PASS in a blocking lane.
+  # The existing `unit-tests` job is untouched and remains the lane that decides.
+  #
+  # NOTHING ELSE IS MODIFIED. No assertion, no skip, no xfail, no gate, no
+  # `tests/conftest.py`, no `redis_manager.py`, and no existing job. The Redis service and
+  # the two Redis environment variables are copied verbatim from `unit-tests` so that the
+  # substrate under diagnosis is the same substrate that failed.
+  #
+  # REMOVE THIS JOB once the four tracebacks are classified. It is scaffolding.
+  # ───────────────────────────────────────────────────────────────────────────────
+  d5-redis-diagnostics:
+    name: D5' Real-Redis Diagnostics (non-blocking)
+    runs-on: ubuntu-latest
+    needs: static-audit
+    # Diagnostic only. See the block comment above: this must never be the reason a pull
+    # request is considered mergeable, and a green badge here is not a D5' acceptance pass.
+    continue-on-error: true
+    # Three small files (~35 tests). The 90-minute budget on `unit-tests` is for 12,000.
+    timeout-minutes: 25
+
+    # Copied verbatim from `unit-tests` so the diagnosis runs on the same substrate.
+    services:
+      redis:
+        image: redis:7-alpine
+        ports:
+          - 6379:6379
+        options: >-
+          --health-cmd "redis-cli ping"
+          --health-interval 10s
+          --health-timeout 5s
+          --health-retries 5
+
+    env:
+      # Both variables, exactly as `unit-tests` sets them. `REDIS_URL` is retained because
+      # `tests/conftest.py` blanks it for everyone and some tests assert on its presence;
+      # `AERORA_TEST_REDIS_URL` is the deliberate opt-in conftest does NOT touch, and is
+      # what carries the endpoint through to `tests/real_redis_gate.py`.
+      REDIS_URL: redis://localhost:6379
+      AERORA_TEST_REDIS_URL: redis://localhost:6379/15
+      ENV: test
+      AERORA_MODE: safe
+      PYTHONPATH: .
+
+    steps:
+      - name: Checkout code
+        uses: actions/checkout@v4
+
+      - name: Set up Python
+        uses: actions/setup-python@v5
+        with:
+          python-version: ${{ env.PYTHON_VERSION }}
+          cache: 'pip'
+          cache-dependency-path: |
+            requirements-cpu.txt
+            requirements-base.txt
+            requirements-dev.txt
+
+      - name: Install dependencies
+        run: |
+          python -m pip install --upgrade pip
+          pip install -r requirements-cpu.txt
+          pip install -r requirements-dev.txt
+          pip install pytest pytest-asyncio
+
+      # PROVES THE GATE REACHED ITS EXECUTION PATH, BEFORE ANY TEST RUNS.
+      # `gate_summary()` is written to contain no URL, host or credential -- it reports the
+      # state and whether the variable is set, which is the whole point of that design. If
+      # this prints `state=skip` the endpoint never arrived and every result below is void;
+      # if it prints `state=fail` the service is configured but unusable. `state=run` is the
+      # only reading under which the test outcomes below mean anything.
+      - name: Record the gate's decision (prints no endpoint)
+        run: |
+          mkdir -p diag-out
+          python -c "from tests.real_redis_gate import gate_summary, GATE_STATE, GATE_REASON; print(gate_summary()); print('state=' + GATE_STATE); print('reason=' + (GATE_REASON or '(none)'))" | tee diag-out/gate_state.txt
+
+      # THREE SEPARATE INVOCATIONS. Not one command with three paths: that is what let the
+      # first failure's traceback crowd out the rest. `continue-on-error` per step so a
+      # failure in the first file cannot stop the other two from producing their evidence.
+      - name: Slot-lock file, ALONE (the 21-of-22 anomaly)
+        continue-on-error: true
+        run: |
+          mkdir -p diag-out
+          pytest tests/test_quota01_exchange_slot_is_atomic.py \
+            -v --tb=long -rf \
+            --junitxml=diag-out/slot_lock.xml \
+            2>&1 | tee diag-out/slot_lock.log
+
+      - name: Metered-reservation file, ALONE (passed in full suite; control)
+        continue-on-error: true
+        run: |
+          mkdir -p diag-out
+          pytest tests/test_quota01_metered_reservation_is_hard.py \
+            -v --tb=long -rf \
+            --junitxml=diag-out/metered.xml \
+            2>&1 | tee diag-out/metered.log
+
+      - name: Webhook file, ALONE (2 of 6 failed in full suite)
+        continue-on-error: true
+        run: |
+          mkdir -p diag-out
+          pytest tests/test_webhook_duplicate_delivery_real_redis.py \
+            -v --tb=long -rf \
+            --junitxml=diag-out/webhook.xml \
+            2>&1 | tee diag-out/webhook.log
+
+      # `if: always()` is load-bearing: the entire purpose is to retain evidence from a
+      # FAILING run. Without it a failure would upload nothing, which is the state that
+      # made run 38043513862 undiagnosable.
+      - name: Upload diagnostics (XML + bounded logs)
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: d5-redis-diagnostics-${{ github.sha }}
+          path: diag-out/
+          if-no-files-found: warn
+          retention-days: 7
