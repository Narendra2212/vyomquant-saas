# ══════════════════════════════════════════════════════════════════════════════
#  VYOMQUANT SAAS PLATFORM — Comprehensive .gitignore
#  Git Release Engineer — Audited 2026-07-24
#  NEVER commit: secrets, keys, databases, caches, compiled files, large binaries
# ══════════════════════════════════════════════════════════════════════════════

# ── SECRETS & CREDENTIALS (CRITICAL — NEVER COMMIT) ──────────────────────────
.env
.env.local
.env.*.local
.env.production
.env.staging
.env.development
.env.test
.env.corrupt*
.env.backup*
.env.txt
*.env

