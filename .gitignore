terraform.zip
terraform-*.zip

# ── PORTABLE GIT / TOOL BINARY DISTRIBUTIONS ─────────────────────────────────
# Prevent accidentally committing a portable Git-for-Windows installation
# or any other embedded binary tool distribution rooted at the repo root.
Git/
git-portable/
PortableGit/

# ── KUBERNETES SECRETS ───────────────────────────────────────────────────────
