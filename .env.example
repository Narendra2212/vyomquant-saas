# ══════════════════════════════════════════════════════════════════════════════
#  VYOMQUANT PLATFORM — Environment Variables Template
#  Copy this file to .env and fill in your actual values.
#  NEVER commit .env to git. NEVER share real keys.
#  Last audited: 2026-07-29
# ══════════════════════════════════════════════════════════════════════════════

# ── SUPABASE (Database & Auth) ─────────────────────────────────────────────
# Find these in: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# ── DATABASE ───────────────────────────────────────────────────────────────
# Format: postgresql://user:password@host:port/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.your-project-ref.supabase.co:6543/postgres?sslmode=require

# ── JWT & AUTH ────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=your-jwt-secret-at-least-64-chars-long
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ── AES-256 ENCRYPTION (Security Vault) ───────────────────────────────────
# Generate key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separate multiple keys for key rotation (newest first)
MASTER_ENCRYPTION_KEYS=your-fernet-key-here,old-key-if-rotating

# Per-deployment PBKDF2 salt for key derivation (Security Vault)
# Generate salt with: python -c "import secrets; print(secrets.token_hex(32))"
CREDENTIAL_VAULT_SALT=your-unique-per-deployment-salt-here

# ── TEST CREDENTIALS (DEV ONLY — never use real accounts) ─────────────────
TEST_USER_EMAIL=your-test-email@example.com
TEST_USER_PASSWORD=your-test-password

# ── REDIS ─────────────────────────────────────────────────────────────────
# Local: redis://localhost:6379
# Cloud: redis://default:PASSWORD@host:port
REDIS_URL=redis://localhost:6379
REDIS_REPLICA_URL=redis://localhost:6380
REDIS_PASSWORD=your-redis-password-if-any

# ── QUESTDB (Telemetry Engine) ────────────────────────────────────────────
QUESTDB_HOST=127.0.0.1
QUESTDB_PORT=9000

# ── APPLICATION ───────────────────────────────────────────────────────────
# VYOMQUANT_MODE controls the execution safety gate.
# Values: safe (read-only, no trades) | paper (simulated trades) | live (real money — DANGER)
# DEPRECATED FALLBACK: 'AERORA_MODE' is a legacy alias for this variable.
#   If set, a deprecation warning is logged. Remove from your deployment config
#   once you confirm no DEPRECATION WARNING entries appear in logs (target: Day 30).
VYOMQUANT_MODE=paper
PRODUCTION_ROUTER_ENABLED=False
HOST=0.0.0.0
PORT=8000
WORKERS=2
ENV=development
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# Comma-separated list of allowed origins for cross-origin requests (CORS).
#
# Only needed when the browser talks to the API on a DIFFERENT origin than the page. In the
# CloudFront same-origin deployment (distribution EEOXECPHQ8SR0 proxies /api/* and /ws/* to the
# ALB) requests are same-origin and CORS never engages. It becomes load-bearing the moment the
# SPA on app.vyomquant.in calls a separate api.vyomquant.in - see infra/dns.md.
#
# Production (vyomquant.in): CORS_ORIGINS=https://vyomquant.in,https://www.vyomquant.in,https://app.vyomquant.in
# Development: CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
#
# Never set this to "*" for an authenticated API. backend_app/main.py defensively drops
# allow_credentials when it sees a wildcard, which breaks Authorization headers instead.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# ── EXCHANGE ──────────────────────────────────────────────────────────────
EXCHANGE_MODE=paper
EXCHANGE_NAME=binance
EXCHANGE_API_KEY=your-exchange-api-key
EXCHANGE_API_SECRET=your-exchange-api-secret
EXCHANGE_API_URL=https://api.binance.com
EXCHANGE_WS_URL=wss://stream.binance.com:9443/ws
PAPER_TRADING_BALANCE_USD=100000.0
PAPER_TRADING_INITIAL_EQUITY=100000.0

# ── PAYMENT GATEWAYS ──────────────────────────────────────────────────────
# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# Razorpay — https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_live_your-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ── ALERTING & NOTIFICATIONS ──────────────────────────────────────────────
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/webhook/url
ALERT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
ALERT_TELEGRAM_ENABLED=false
ALERT_EMAIL_ENABLED=false

# ── MONITORING ────────────────────────────────────────────────────────────
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_ENDPOINT=/metrics
GRAFANA_URL=http://localhost:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your-grafana-admin-password

# ── ALERTMANAGER ──────────────────────────────────────────────────────────
ALERTMANAGER_ENABLED=false
ALERTMANAGER_URL=http://localhost:9093

# ── SMTP EMAIL ────────────────────────────────────────────────────────────
EMAIL_SMTP_HOST=smtp.yourmailserver.com
EMAIL_SMTP_PORT=587
EMAIL_USER=your-smtp-username@domain.com
EMAIL_PASSWORD=your-smtp-password

# ── FRONTEND ──────────────────────────────────────────────────────────────
# FRONTEND_URL is not cosmetic: the backend builds user-visible redirect targets from it -
# Stripe success/cancel URLs and the Razorpay callback_url (backend_app/routers/billing.py),
# marketplace checkout returns (backend/marketplace/checkout_service.py) and referral links
# (routers/referral.py, backend/dashboard_aggregation_service.py). If it is unset in production
# those links silently fall back to localhost and users are dropped on a dead page after paying.
# Production: FRONTEND_URL=https://app.vyomquant.in
FRONTEND_URL=http://localhost:5173

# APP_URL overrides FRONTEND_URL for referral/signup links only. Leave unset to inherit.
# Production: APP_URL=https://app.vyomquant.in

# Production (same-origin via CloudFront): VITE_API_URL=https://app.vyomquant.in
# Production (dedicated API host):         VITE_API_URL=https://api.vyomquant.in
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# Supabase (client-side — anon key only, safe for frontend)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ── OBSERVABILITY ─────────────────────────────────────────────────────────
VITE_SENTRY_DSN=https://your-project-id@o0.ingest.sentry.io/your-project
VITE_GA_TRACKING_ID=G-your-analytics-id
VITE_CLARITY_PROJECT_ID=your-clarity-project-id

# ── LOGGING ───────────────────────────────────────────────────────────────
LOG_FILE=/app/logs/app.log
LOG_MAX_BYTES=50000000
LOG_BACKUP_COUNT=5
ELASTICSEARCH_URL=http://elasticsearch:9200
LOKI_URL=http://loki:3100

# ── CIRCUIT BREAKER ───────────────────────────────────────────────────────
CIRCUIT_BREAKER_DAILY_LOSS_THRESHOLD=5.0
CIRCUIT_BREAKER_DRAWDOWN_THRESHOLD=10.0
CIRCUIT_BREAKER_CONSECUTIVE_FAILURES=5

# ── EXECUTION GUARD ───────────────────────────────────────────────────────
EXECUTION_GUARD_ENABLED=true
EXECUTION_GUARD_MIN_BALANCE=100.0
EXECUTION_GUARD_MAX_POSITION_SIZE_PCT=10.0
EXECUTION_GUARD_MAX_DAILY_TRADES=100

# ── WEBSOCKET ─────────────────────────────────────────────────────────────
WS_STALE_THRESHOLD_SECONDS=30.0
WS_AUTO_RECONNECT=true

# ── RATE LIMITING ─────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ── DATABASE POOL ─────────────────────────────────────────────────────────
DATABASE_POOL_SIZE=10

# ── FEATURE FLAGS ─────────────────────────────────────────────────────────
FEATURE_TRADING_ENABLED=true
FEATURE_WEBSOCKET_ENABLED=true
FEATURE_BACKTESTING_ENABLED=true
FEATURE_ML_PREDICTIONS_ENABLED=true
FEATURE_RISK_MANAGEMENT_ENABLED=true
FEATURE_EMERGENCY_LIQUIDATION_ENABLED=true
FEATURE_DEBUG_ENDPOINTS_ENABLED=false
FEATURE_MOCK_EXCHANGE_ENABLED=false
FEATURE_PAPER_TRADING_BALANCE_RESET=false
