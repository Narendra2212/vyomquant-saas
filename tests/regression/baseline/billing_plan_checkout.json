              "annotation": "dict",
              "depends_on": "get_current_user"
            }
          },
          "raises": [],
          "returns": [
            {
              "amount": "computed",
              "checkoutUrl": "computed",
              "checkout_url": "computed",
              "currency": "computed",
              "provider": "str"
            },
            {
              "amount": "computed",
              "checkoutUrl": "computed",
              "checkout_url": "computed",
              "currency": "str",
              "key_id": "computed",
              "order_id": "computed",
              "provider": "str",
              "razorpay_key": "computed"
            }
          ],
          "route_path": "/api/billing/checkout"
        }
      ],
