  "access_tracking_after_a_read": {
    "access_count": 1,
    "last_accessed_is_set": true
  },
  "capture": "credential_vault",
  "collaborator_sequence": [
    {
      "call": "--- fetch by the owning tenant ---"
    },
    {
      "call": "redis_manager.get",
      "key_template": "tenant:{tenant_id}:user:{user_id}:credential:{credential_id}"
    },
    {
      "call": "redis_manager.setex",
      "key_template": "tenant:{tenant_id}:user:{user_id}:credential:{credential_id}",
      "ttl_seconds": 86400
    },
    {
      "call": "redis_manager.setex",
      "key_template": "tenant:{tenant_id}:credential_access_log:{log_id}",
      "ttl_seconds": 2592000
    },
    {
      "call": "redis_manager.lpush",
      "key_template": "credential_vault:audit_log"
    },
    {
      "call": "--- fetch by another tenant ---"
    },
    {
      "call": "redis_manager.get",
      "key_template": "tenant:{tenant_id}:user:{user_id}:credential:{credential_id}"
    },
    {
      "call": "--- fetch of an absent credential ---"
    },
    {
      "call": "redis_manager.get",
      "key_template": "tenant:{tenant_id}:user:{user_id}:credential:{credential_id}"
    },
    {
      "call": "--- fetch of a row whose stored tenant disagrees with its key ---"
    },
    {
      "call": "redis_manager.get",
      "key_template": "tenant:{tenant_id}:user:{user_id}:credential:{credential_id}"
    },
    {
      "call": "redis_manager.setex",
      "key_template": "tenant:{tenant_id}:credential_access_log:{log_id}",
      "ttl_seconds": 2592000
    },
    {
      "call": "redis_manager.lpush",
      "key_template": "credential_vault:audit_log"
    }
  ],
  "credential_id_is_a_pure_derivation": true,
  "credential_types": [
