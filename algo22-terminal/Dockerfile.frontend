# Dockerfile.frontend
FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy source code
COPY . .

# Expose Vite dev server port
EXPOSE 3000

# Run development server with host bindings
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"]
