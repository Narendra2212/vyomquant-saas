          "FOK",
          "PO"
        ],
        "options_source": null,
        "unit": null,
        "example": "GTC",
        "help": "How long the order stays live. Blank uses the venue default resolved at execution.",
        "depends_on": [],
        "affects_warmup": false
      },
      {
        "key": "reduce_only",
        "label": "Reduce only",
        "type": "BOOLEAN",
        "required": false,
