# Template for algo22-terminal/.env.production
#
# NOTE: CI does not read this file. .github/workflows/06-frontend-deploy.yml injects
# VITE_API_URL / VITE_WS_URL / VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY / VITE_SENTRY_DSN from
# GitHub Actions secrets and fails the build if any are missing. Those secrets are the real
# production source of truth; this file only affects local `npm run build` runs.
#
# Pick ONE of the two API topologies below - see infra/dns.md for the full comparison.
#
# Option A (recommended, same-origin): CloudFront EEOXECPHQ8SR0 serves the SPA from S3 and
# reverse-proxies /api/*, /ws/*, /health* to the ALB, so the API shares the page's origin and
# CORS never engages.
VITE_API_URL=https://app.vyomquant.in
VITE_WS_URL=wss://app.vyomquant.in

# Option B (dedicated API hostname on the ALB). Cross-origin, so CORS_ORIGINS on the
# vyomquant-api ECS task definition must list https://app.vyomquant.in.
# VITE_API_URL=https://api.vyomquant.in
# VITE_WS_URL=wss://api.vyomquant.in

# Supabase project URL and anon key. The anon key is publishable by design; the service_role
# key must NEVER appear here - the deploy workflow greps the built bundle and fails if it does.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# Optional observability. Leaving a value empty (or containing "dummy") makes index.html's
# isDummy() guard no-op the integration rather than shipping a broken loader.
VITE_SENTRY_DSN=
VITE_GA_TRACKING_ID=
VITE_CLARITY_PROJECT_ID=

# Optional: external documentation site opened from the sidebar. Unset hides the nav entry
# rather than shipping a link to a domain that no longer belongs to this product.
VITE_DOCS_URL=
