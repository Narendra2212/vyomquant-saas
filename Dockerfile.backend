# Build stage
FROM python:3.11-slim as builder

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies using root requirements.txt
COPY requirements.txt .
RUN pip wheel --no-cache-dir --no-deps --wheel-dir /app/wheels -r requirements.txt

# Final stage
FROM python:3.11-slim

WORKDIR /app

# Install runtime dependencies for psycopg2
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -u 1000 appuser

# Copy wheels and install
COPY --from=builder /app/wheels /wheels
COPY --from=builder /app/requirements.txt .
RUN pip install --no-cache /wheels/*

# Copy canonical backend package
# backend_app/ is the ONLY backend — aerora_quant_backend_updated_final1/ is excluded
COPY --chown=appuser:appuser backend_app/ ./backend_app/

# Switch to non-root user
USER appuser

# Expose port
EXPOSE 8000

# PYTHONPATH ensures backend_app package is importable from /app
ENV PYTHONPATH=/app

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run canonical backend — backend_app.main:app (package-qualified import)
CMD ["uvicorn", "backend_app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
