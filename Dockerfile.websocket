# STEP 1: WEBSOCKET SERVER — Dockerfile
#
# Dedicated container for WebSocket server
# Optimized for handling 150+ concurrent connections

FROM python:3.11-slim as builder

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy requirements first for better caching
COPY requirements-base.txt requirements-cpu.txt ./
RUN pip install --no-cache-dir --user -r requirements-cpu.txt

# Production stage
FROM python:3.11-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -u 1000 websocket

# Set working directory
WORKDIR /app

# Copy Python packages from builder
COPY --from=builder /root/.local /home/websocket/.local
ENV PATH=/home/websocket/.local/bin:$PATH

# Copy canonical backend package
# WebSocket server lives in backend_app/backend/ws_server.py
COPY --chown=websocket:websocket backend_app/ ./backend_app/

# Change to non-root user
USER websocket

# PYTHONPATH ensures backend_app package is importable from /app
ENV PYTHONPATH=/app

# Expose WebSocket port
EXPOSE 8002

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8002/health/live || exit 1

# Run WebSocket server with 4 workers
# Each worker can handle ~100 concurrent connections
# Total: 400 concurrent connections capacity
CMD ["python", "-m", "uvicorn", "backend_app.backend.ws_server:app", \
     "--host", "0.0.0.0", \
     "--port", "8002", \
     "--workers", "4", \
     "--loop", "uvloop", \
     "--http", "httptools", \
     "--log-level", "info"]

